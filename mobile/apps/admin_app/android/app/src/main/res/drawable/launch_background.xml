<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the first frame of the Flutter splash (LpgSplash) so the hand-off is seamless. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#223F8B"
                android:endColor="#0B173C" />
        </shape>
    </item>
</layer-list>
