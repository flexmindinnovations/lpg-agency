{$SITE_ADDRESS::80} {
	encode zstd gzip

	@backend path /api/* /health/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# Hashed build assets never change for a given name; everything else
		# (index.html above all) must be revalidated so a deploy is picked up
		# immediately instead of running against a stale bundle.
		@hashed path_regexp hashed -[A-Za-z0-9]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
