# @ngrx/signals 21 declares an Angular 21 peer range while this workspace is on
# Angular 22 (the 22-compatible release is not out yet); the API we use is
# unchanged. Without this, a plain `npm ci` fails with ERESOLVE (QA finding
# SU-03). Remove once @ngrx/signals publishes an Angular 22 peer range.
legacy-peer-deps=true
