# Third-party credentials for the production backend and worker.
#
#   cp integrations.env.example integrations.env && chmod 600 integrations.env
#   # uncomment and fill in only the integrations you are turning on, then:
#   docker compose -f docker-compose.prod.yml up -d backend worker
#
# integrations.env is git-ignored and optional: without it every integration
# below stays off and the rest of the app works.
#
# Leave a line COMMENTED OUT rather than blank (`KEY=`). Several of these
# settings treat "unset" and "empty" differently, and an empty secret is not
# the same as no secret.

# -- AI: Anthropic (WhatsApp assistant + AI Command Center) -------------------
# LPG_AI_PROVIDER=anthropic
# LPG_ANTHROPIC_API_KEY=

# -- SMS: MSG91 with DLT-registered templates ---------------------------------
# Sender ID and DLT entity ID are configured in the MSG91 dashboard; here go
# the auth key and the MSG91 template ID bound to each DLT template.
# LPG_SMS_PROVIDER=msg91
# LPG_MSG91_AUTH_KEY=
# LPG_SMS_TEMPLATE_LOGIN_OTP=
# LPG_SMS_TEMPLATE_DELIVERY_OTP=
# LPG_SMS_TEMPLATE_BOOKING_CONFIRMED=
# LPG_SMS_TEMPLATE_OUT_FOR_DELIVERY=
# LPG_SMS_TEMPLATE_DELIVERY_CONFIRMED=

# -- Online payments: Razorpay (live keys; production refuses rzp_test_) ------
# Webhook URL to register in Razorpay: https://<domain>/api/v1/payments/razorpay/webhook
# LPG_RAZORPAY_KEY_ID=rzp_live_
# LPG_RAZORPAY_KEY_SECRET=
# LPG_RAZORPAY_WEBHOOK_SECRET=
# Optional: page the customer returns to after paying.
# LPG_PAYMENT_LINK_CALLBACK_URL=

# -- WhatsApp Cloud API (Meta) ------------------------------------------------
# Webhook URL to register in the Meta app: https://<domain>/api/v1/webhooks/whatsapp
# Each agency's WhatsApp phone number ID is set per tenant in Tenant
# Configuration (`whatsapp_phone_number_id`), not here.
# LPG_WHATSAPP_ACCESS_TOKEN=
# LPG_WHATSAPP_APP_SECRET=
# LPG_WHATSAPP_VERIFY_TOKEN=

# -- Push notifications: Firebase Cloud Messaging -----------------------------
# Service-account JSON for the Firebase project the apps' google-services.json
# belongs to, on ONE line.
# LPG_FCM_PROJECT_ID=
# LPG_FCM_CREDENTIALS_JSON=
