# ==========================================================================
# LPG Agency Management Platform — root environment template
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# Every value below is a development placeholder and is safe in source control
# precisely because it is worthless outside a local container.
# ==========================================================================

# --------------------------------------------------------------------------
# PostgreSQL (docker compose)
# --------------------------------------------------------------------------
# Only the host port is configurable. Database and role names are fixed in
# docker-compose.yml and the init SQL — see the comment there for why.
#
# Non-default port so this stack does not collide with a PostgreSQL already
# running on your machine.
POSTGRES_PORT=55432

# For reference, created by infrastructure/docker/postgres/init/01-init.sql:
#   databases : lpg_dev, lpg_test
#   lpg_admin : superuser  — migrations and administration only
#   lpg_app   : NOSUPERUSER, NOBYPASSRLS — the application connects as this
#
# That role separation is what makes PostgreSQL Row-Level Security an effective
# tenant-isolation backstop (ADR-017). Do not collapse them into one role.

# --------------------------------------------------------------------------
# Redis (docker compose)
# --------------------------------------------------------------------------
REDIS_PORT=56379

# --------------------------------------------------------------------------
# Frontend
# --------------------------------------------------------------------------
# AG Grid Enterprise licence key (ADR-020).
# Leave empty for now — the wrapper runs on AG Grid Community until a licence
# is procured (tracked as DW-08). An empty value is a supported state, not a
# misconfiguration.
AG_GRID_LICENSE_KEY=
