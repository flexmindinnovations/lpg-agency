# ==========================================================================
# PRODUCTION environment — Supabase cloud PostgreSQL
#
#   cd backend && cp .env.prod.example .env    (or supply these via the
#                                               platform's secret store)
#
# .env is git-ignored. THIS FILE IS COMMITTED — never put a real password in
# it. The password below is an empty placeholder for exactly that reason.
#
# Supabase is the managed PostgreSQL host and nothing more (ADR-027).
# Supabase Auth, Storage, Realtime and Edge Functions are not adopted; the
# backend uses SQLAlchemy 2.x + Alembic against plain PostgreSQL.
# ==========================================================================

LPG_ENVIRONMENT=production
LPG_DEBUG=false
LPG_LOG_LEVEL=INFO
LPG_LOG_JSON=true

# A wildcard origin is rejected at startup outside `local`. Name the real
# dashboard origin.
LPG_CORS_ORIGINS=https://app.example.com

# --------------------------------------------------------------------------
# Database — Supabase project ayqphthelemlnbtnknkp
# --------------------------------------------------------------------------
# These parts are composed into a DSN, with the password URL-encoded — so a
# password containing @ : / ? # cannot corrupt the connection string. Set the
# password here (in your real .env) and nothing else needs to change.
LPG_DB_HOST=db.ayqphthelemlnbtnknkp.supabase.co
LPG_DB_PORT=5432
LPG_DB_NAME=postgres
LPG_DB_USER=postgres
LPG_DB_PASSWORD=

# --------------------------------------------------------------------------
# ⚠️  READ THIS BEFORE GOING LIVE — `postgres` is a superuser
# --------------------------------------------------------------------------
# The values above use the `postgres` superuser. That is correct for
# MIGRATIONS, and it is what Supabase gives you on the direct connection.
#
# It is NOT correct for the APPLICATION.
#
# `postgres` is a superuser, and superusers bypass Row-Level Security. RLS is
# the backstop that keeps one tenant's data invisible to another when
# application code is wrong (ADR-017). Connecting the application as
# `postgres` removes that backstop silently — nothing fails, nothing logs, and
# every tenant's rows become visible to every query.
#
# Before production, provision a dedicated application role (DW-19):
#
#   CREATE ROLE lpg_app WITH LOGIN PASSWORD '<strong-password>'
#       NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS INHERIT;
#   GRANT CONNECT ON DATABASE postgres TO lpg_app;
#   GRANT USAGE ON SCHEMA public TO lpg_app;
#
# Run that once, as `postgres`, through the Supabase SQL editor. Role creation
# is administrative rather than schema, so it does not belong in an Alembic
# migration. `infrastructure/docker/postgres/init/01-init.sql` is the
# reference — the local environment already works this way.
#
# Then point the application at that role and use the TRANSACTION POOLER,
# leaving the direct connection to migrations:
#
#   LPG_DB_HOST=aws-0-<region>.pooler.supabase.com
#   LPG_DB_PORT=6543
#   LPG_DB_USER=lpg_app.ayqphthelemlnbtnknkp
#   LPG_DB_PASSWORD=<application-role-password>
#   LPG_DATABASE_STATEMENT_CACHE_SIZE=0
#
# The cache setting is not optional behind the transaction pooler: asyncpg
# caches prepared statements per connection, and the pooler hands that
# connection to a different client between statements. The failure is
# intermittent "prepared statement does not exist" errors that appear only
# under load.
#
# NEVER use the `service_role` key for a database connection. It bypasses RLS
# by design.
# --------------------------------------------------------------------------

# Migrations: direct connection, elevated role. Set the password in your .env.
LPG_MIGRATION_DATABASE_URL=

# Direct connection today. Set to 0 when the application moves to the
# transaction pooler (see above).
LPG_DATABASE_STATEMENT_CACHE_SIZE=100

# --------------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------------
# Supplied by the managed Redis instance. Never committed.
LPG_REDIS_URL=

# --------------------------------------------------------------------------
# Authentication — NOT IMPLEMENTED
# --------------------------------------------------------------------------
# Phase 6, not Phase 1. Kept separate from database configuration so that
# adopting or declining an identity provider never entangles the database
# connection. No JWT secret or signing key is defined yet.
