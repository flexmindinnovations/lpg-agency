# ==========================================================================
# Backend environment template — canonical reference
#
# Per-environment templates, pick one:
#
#   cp .env.dev.example  .env    dev  — local Docker, database lpg_dev
#   cp .env.uat.example  .env    uat  — local Docker, database lpg_uat
#   cp .env.prod.example .env    prod — Supabase cloud
#
# This file documents every available setting. The three above are the
# ready-to-use starting points.
#
# .env is git-ignored and must never be committed. Every value below is either
# a placeholder or a local-only development credential worthless outside its
# container.
#
# All settings are read through Pydantic Settings (`src/lpg/config/settings.py`)
# with the LPG_ prefix. Nothing in the codebase reads os.environ directly, so
# every knob is discoverable, typed, and validated at startup rather than at
# first use.
# ==========================================================================

# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
LPG_ENVIRONMENT=local
LPG_DEBUG=false
LPG_APP_VERSION=0.1.0

# Wildcard origins and debug mode are rejected at startup outside `local`.
LPG_CORS_ORIGINS=http://localhost:4200

# --------------------------------------------------------------------------
# Database — local development (docker compose)
# --------------------------------------------------------------------------
# The application connects as `lpg_app`: NOSUPERUSER, NOBYPASSRLS. That is not
# a detail — PostgreSQL Row-Level Security is the backstop that holds when
# application code is wrong, and a role able to bypass it removes the backstop
# silently (ADR-017).
LPG_DATABASE_URL=postgresql+asyncpg://lpg_app:dev_only_not_a_real_secret@localhost:55432/lpg_dev

# Alembic connects separately, as the elevated role. Migrations are an
# administrative act; the application never issues DDL.
LPG_MIGRATION_DATABASE_URL=postgresql+asyncpg://lpg_admin:dev_only_not_a_real_secret@localhost:55432/lpg_dev

# Integration tests target the test database, as the application role — testing
# as a superuser would silently pass tenant-isolation checks that production
# would fail.
LPG_TEST_DATABASE_URL=postgresql+asyncpg://lpg_app:dev_only_not_a_real_secret@localhost:55432/lpg_test

LPG_DATABASE_ECHO=false
LPG_DATABASE_POOL_SIZE=10
LPG_DATABASE_MAX_OVERFLOW=5
LPG_DATABASE_POOL_TIMEOUT_SECONDS=30

# asyncpg's prepared-statement cache. Keep the default for direct connections.
# Set to 0 behind a transaction-mode pooler — see the Supabase section below.
LPG_DATABASE_STATEMENT_CACHE_SIZE=100

# --------------------------------------------------------------------------
# Database — Supabase (hosted)
# --------------------------------------------------------------------------
# Supabase is the managed PostgreSQL host and nothing more (ADR-027).
# Supabase Auth, Storage, Realtime and Edge Functions are NOT adopted; the
# backend continues to use SQLAlchemy 2.x + Alembic against plain PostgreSQL.
#
# To point at Supabase, replace the two URLs above with the values below.
# Never paste a real password into this file — it is committed. Put it in .env.
#
# Supabase exposes three connection endpoints, and which one you use matters:
#
#   Direct            port 5432, host db.<ref>.supabase.co
#                     Session-level features, no pooling. Use for MIGRATIONS.
#
#   Session pooler    port 5432, host aws-0-<region>.pooler.supabase.com
#                     Pooled but session-scoped. IPv4-friendly alternative to
#                     direct.
#
#   Transaction pooler  port 6543, same pooler host
#                     Highest concurrency. Use for the APPLICATION.
#                     REQUIRES LPG_DATABASE_STATEMENT_CACHE_SIZE=0 — asyncpg
#                     caches prepared statements per connection, and a
#                     transaction pooler hands that connection to a different
#                     client between statements. The symptom is intermittent
#                     "prepared statement does not exist" errors that only
#                     appear under load.
#
# Application connection — transaction pooler:
# LPG_DATABASE_URL=postgresql+asyncpg://<db-user>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# LPG_DATABASE_STATEMENT_CACHE_SIZE=0
#
# Migration connection — direct:
# LPG_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# <db-user> must be a dedicated NOSUPERUSER, NOBYPASSRLS role — never
# `service_role`, whose key bypasses RLS by design, and never `postgres` for
# the application path. Provisioning that role is tracked as DW-19.

# --------------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------------
# Cache, sessions, rate limiting, the job queue, and the real-time Pub/Sub
# backplane (ADR-015). A critical dependency; monitored as one.
LPG_REDIS_URL=redis://localhost:56379/0
LPG_TEST_REDIS_URL=redis://localhost:56379/1

# --------------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------------
LPG_LOG_LEVEL=INFO
LPG_LOG_JSON=true
LPG_CORRELATION_ID_HEADER=X-Correlation-ID
LPG_HEALTH_CHECK_TIMEOUT_SECONDS=3.0

# --------------------------------------------------------------------------
# Authentication — NOT IMPLEMENTED
# --------------------------------------------------------------------------
# Authentication is Phase 6, not Phase 1. Deliberately kept separate from
# database configuration above so that adopting or declining a given identity
# provider never entangles the database connection.
#
# No JWT secret, signing key or identity-provider credential is defined here
# yet. When Phase 6 lands, those values are supplied by the environment and
# read through Pydantic Settings like everything else — never hardcoded, and
# never committed.
