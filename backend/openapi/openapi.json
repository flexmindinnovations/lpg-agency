{
  "components": {
    "schemas": {
      "DependencyStatus": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "healthy": {
            "title": "Healthy",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "healthy"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "LivenessResponse": {
        "description": "Process is up. Nothing external is consulted.",
        "properties": {
          "app_name": {
            "title": "App Name",
            "type": "string"
          },
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "app_name",
          "version"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Multi-tenant SaaS platform for LPG distributors.\n\nAll error responses follow RFC 7807 Problem Details, extended with a stable `error_code`. Success responses return the resource directly — there is no success envelope.",
    "title": "LPG Agency Management Platform",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Returns 200 whenever the process is running. Checks no external dependency by design — a failure here means the container should be restarted.",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Reports whether every dependency required to serve traffic is reachable. Returns 503 when any dependency is down, so the instance is removed from rotation without being restarted.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "One or more dependencies are unavailable"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness and readiness probes.",
      "name": "Health"
    }
  ]
}
