# ==========================================================================
# UAT environment — local Docker PostgreSQL, separate database
#
#   cd backend && cp .env.uat.example .env
#
# UAT shares the Docker instance with dev but uses its own database
# (`lpg_uat`), so UAT data and dev data cannot contaminate each other while
# still guaranteeing the same engine version, extensions and role privileges.
#
# .env is git-ignored. No real credential appears below.
# ==========================================================================

LPG_ENVIRONMENT=uat
LPG_DEBUG=false
LPG_LOG_LEVEL=INFO
LPG_LOG_JSON=true

# Non-local environments reject a wildcard origin at startup. Name the real
# UAT dashboard origin here.
LPG_CORS_ORIGINS=http://localhost:4200

# --------------------------------------------------------------------------
# Database — local Docker, lpg_uat
# --------------------------------------------------------------------------
LPG_DB_HOST=localhost
LPG_DB_PORT=55432
LPG_DB_NAME=lpg_uat
# UAT gets its own role, not lpg_app — PostgreSQL roles are cluster-wide, so
# a shared role could not hold a password different from dev's.
LPG_DB_USER=lpg_app_uat
LPG_DB_PASSWORD=uat123

# Migrations still run as the elevated superuser role, unaffected by the
# app-level credential above.
LPG_MIGRATION_DATABASE_URL=postgresql+asyncpg://lpg_admin:dev_only_not_a_real_secret@localhost:55432/lpg_uat

LPG_DATABASE_STATEMENT_CACHE_SIZE=100

# --------------------------------------------------------------------------
# Redis — local Docker, separate logical database from dev
# --------------------------------------------------------------------------
LPG_REDIS_URL=redis://localhost:56379/2

# --------------------------------------------------------------------------
# Object storage — same local Docker MinIO, separate bucket from dev
# --------------------------------------------------------------------------
LPG_STORAGE_ENDPOINT_URL=http://localhost:59000
LPG_STORAGE_ACCESS_KEY=lpg_storage
LPG_STORAGE_SECRET_KEY=dev_only_not_a_real_secret
LPG_STORAGE_BUCKET=lpg-uat
LPG_STORAGE_REGION=us-east-1

# --------------------------------------------------------------------------
# Identity / Authentication — RS256 JWT signing (Phase 6, ADR-035)
# --------------------------------------------------------------------------
# A separate throwaway keypair from DEV's — a UAT session shouldn't verify
# against DEV's key or vice versa, the same isolation the separate DB
# role/password above already gives UAT. See .env.dev.example's identical
# note on the `\n`-escaping.
LPG_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQDYOGdU/UZNEaIn\n6MauGHE/bCSR/xG0BJHCuJjcyN9FJS4KD2MqW68LUPwLpMuJxvZ2dTiKNooBqjqi\nudwNAcFoP33y04ML0vE8ihMV3UIcg8JKZNjNa9Pspu/cJrA+tq4pvNe5pxIfp2GD\nsCrIQXk2KMrtQqYtOooZWs+sPzV3yWWVvo89uWpHUfEj4/oseKP+h7j+r+jR4FeT\ncJsDuYfI52DVnBa+7Lmb21eEF3T5Q5QueE80dcB+QVtV0OQcGzOtBYc450YpQIBD\nRryC5PTcGDUdnZKfybGcFTKjpE8DJxLy1qj84O2j5Pb4Rullp32e/ALwSx0cDrDs\nfM+XvPrjAgMBAAECggEACgZPcCbQABm9sWj+8Spr8btTVLuFOBnwIh2J5M6hX2TS\nZiABgoC+tGEcVnPdBfXGDobvyKSvsFUSo+HHHIlEzM8IyV3aGQ2+JobmTKC2BHlt\nZCKZ1KhXqoSw4T2f9UBmAcRiIhbnZbVOdZsQ2LkEZCjvA6IP70/kADnwH/XMRlHn\nvpZ6cQpgXYtyPyNzCj0DUENWsDhjxQu1ekfwwe3pVRL71CYwqWn4gCeSzUYPmV/N\nVQuMSsLyjdFAchrDt/seMtD3at2hmLPIWteGQngcWHKx13OhAuaMBa61tfOJXXNY\ngzinZHoCnSWcLuSDL6WCC6wLEL6GObcCmMkq9t0bqQKBgQD3LQoTTyMU2rO69xDR\ngIqgaLZc3Xu5N/3YyVJgJRSUFABJH8gselv22C0hb78dVuigQCD545pCgxVyqEiR\nq8Qo5OSh36xqPwWFNQnao3yCoPle8/K9N1cz403a6ubWGT9hUJLjYpRtx9NBuANS\nCRzo9K9xZ8iWqqehqd8DBdY5qQKBgQDf8HVgdtaVdmg5Pj+eUFffVWTueHuBlXab\nxemRs9R9gI42/6xVIgLNn1HKVXvH8p0dkH6Q+31l56Qy37qiqxPWANu/Uqd2kt8D\nw+VAZ3GlMtF3/6uNidkopmRlxzXtGTHhhogiBCt3CsShtE4IKWJKws8Y3Cols5AQ\najFNrwEfqwKBgQDeMmzWQtPEkX30WtmRm74CyV72SFxKep0F3qTgrTS8kOZY1es6\noJw/YMHhRvVEyLXCKSP7v7ESjYggVEs4OHLUWD93jP0PXav2vWEoXMM3IsJJq37Q\nvgj0Kif43iW43WVuc+I36oyHy5SLhYHmoy6L9Doq9iMJ3ktnNq+1pe+YUQKBgH2H\nrDRbyWPVEQ1tkHntLaTamI546Tq1jtw5L/nl5WpIou+/mFnMi+e5tD6Idq+Zl2sY\nMWqSHzP9inSeJ1/CKIdgyc3QxmDYab0RlbPpiLIC75qlrgPUTu/Tfhnzdo4m/mge\nYrc2wSqk1Z6TlN5MXHXuB+s2l0W1Bz+8V1DlleqrAoGBANqJl1vZcnPtlxwVL77z\nCNa6vdBq14L95lPuog+ZAlMpPTLS0yfqLUoUxkK9lnlIeSQKhMlCx+eTmpq8uYDv\nF2yOkDR8vn0+OeDSamFZ8dpt4S3W9b0lLmWIySqXEIWXtB7yt0KzAZGd1SlGFrTn\n28b+HWTf8q2Q4qbU6L4vzI2q\n-----END PRIVATE KEY-----\n
