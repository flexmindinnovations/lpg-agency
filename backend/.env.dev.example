# ==========================================================================
# DEV environment — local Docker PostgreSQL
#
#   cd backend && cp .env.dev.example .env
#
# .env is git-ignored. This template is committed and contains no real
# credential: the password below is a container-local value, worthless
# outside your machine.
# ==========================================================================

LPG_ENVIRONMENT=dev
LPG_DEBUG=false
LPG_LOG_LEVEL=DEBUG
LPG_LOG_JSON=false
LPG_CORS_ORIGINS=http://localhost:4200

# --------------------------------------------------------------------------
# Database — local Docker (./scripts/dev-up.sh)
# --------------------------------------------------------------------------
LPG_DB_HOST=localhost
LPG_DB_PORT=5433
LPG_DB_NAME=lpg_dev
LPG_DB_USER=lpg_app
LPG_DB_PASSWORD=dev123

# Migrations run as the elevated role. The application never issues DDL.
# lpg_admin keeps its original bootstrap password — it's the container
# superuser, a separate concern from the per-environment app credential above.
LPG_MIGRATION_DATABASE_URL=postgresql+asyncpg://lpg_admin:dev_only_not_a_real_secret@localhost:5433/lpg_dev

# lpg_test shares the lpg_app role (and so this password) with lpg_dev —
# PostgreSQL roles are cluster-wide, one username can't hold two passwords.
LPG_TEST_DATABASE_URL=postgresql+asyncpg://lpg_app:dev123@localhost:5433/lpg_test

# Direct connection, so asyncpg's prepared-statement cache is a win.
LPG_DATABASE_STATEMENT_CACHE_SIZE=100

# --------------------------------------------------------------------------
# Redis — local Docker
# --------------------------------------------------------------------------
LPG_REDIS_URL=redis://localhost:56379/0
LPG_TEST_REDIS_URL=redis://localhost:56379/1

# --------------------------------------------------------------------------
# File storage - the server's own disk (ADR-068)
# --------------------------------------------------------------------------
LPG_STORAGE_LOCAL_DIR=./data/uploads

# --------------------------------------------------------------------------
# Identity / Authentication — RS256 JWT signing (Phase 6, ADR-035)
# --------------------------------------------------------------------------
# No key is committed here: this repository is public, so a committed key
# would let anyone forge a sign-in. After copying this file to .env, run
#   python scripts/generate_jwt_keys.py
# to write your own pair into it. `environment=dev` is not `is_local`, so
# Settings won't generate a throwaway pair for you.
LPG_JWT_PRIVATE_KEY=
LPG_JWT_PUBLIC_KEY=

# -- Online payments (Razorpay, ADR-053) -------------------------------------
# Test keys from https://dashboard.razorpay.com (Test Mode) -> Account & Settings
# -> API Keys. Live keys (rzp_live_...) only in production.
LPG_PAYMENTS_PROVIDER=razorpay
LPG_RAZORPAY_KEY_ID=
LPG_RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook (Settings -> Webhooks), with URL
# https://<api-host>/api/v1/payments/razorpay/webhook and events
# payment_link.paid, payment_link.expired, payment_link.cancelled.
LPG_RAZORPAY_WEBHOOK_SECRET=
# Optional: page the customer's browser returns to after paying.
LPG_PAYMENT_LINK_CALLBACK_URL=
LPG_PAYMENT_LINK_TTL_MINUTES=1440
