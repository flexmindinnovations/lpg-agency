# ==========================================================================
# DEV environment — local Docker PostgreSQL
#
#   cd backend && cp .env.dev.example .env
#
# .env is git-ignored. This template is committed and contains no real
# credential: the password below is a container-local value, worthless
# outside your machine.
# ==========================================================================

LPG_ENVIRONMENT=dev
LPG_DEBUG=false
LPG_LOG_LEVEL=DEBUG
LPG_LOG_JSON=false
LPG_CORS_ORIGINS=http://localhost:4200

# --------------------------------------------------------------------------
# Database — local Docker (./scripts/dev-up.sh)
# --------------------------------------------------------------------------
LPG_DB_HOST=localhost
LPG_DB_PORT=55432
LPG_DB_NAME=lpg_dev
LPG_DB_USER=lpg_app
LPG_DB_PASSWORD=dev123

# Migrations run as the elevated role. The application never issues DDL.
# lpg_admin keeps its original bootstrap password — it's the container
# superuser, a separate concern from the per-environment app credential above.
LPG_MIGRATION_DATABASE_URL=postgresql+asyncpg://lpg_admin:dev_only_not_a_real_secret@localhost:55432/lpg_dev

# lpg_test shares the lpg_app role (and so this password) with lpg_dev —
# PostgreSQL roles are cluster-wide, one username can't hold two passwords.
LPG_TEST_DATABASE_URL=postgresql+asyncpg://lpg_app:dev123@localhost:55432/lpg_test

# Direct connection, so asyncpg's prepared-statement cache is a win.
LPG_DATABASE_STATEMENT_CACHE_SIZE=100

# --------------------------------------------------------------------------
# Redis — local Docker
# --------------------------------------------------------------------------
LPG_REDIS_URL=redis://localhost:56379/0
LPG_TEST_REDIS_URL=redis://localhost:56379/1

# --------------------------------------------------------------------------
# Object storage — local Docker MinIO (Phase 3, D-40)
# --------------------------------------------------------------------------
LPG_STORAGE_ENDPOINT_URL=http://localhost:59000
LPG_STORAGE_ACCESS_KEY=lpg_storage
LPG_STORAGE_SECRET_KEY=dev_only_not_a_real_secret
LPG_STORAGE_BUCKET=lpg-dev
LPG_STORAGE_REGION=us-east-1

# --------------------------------------------------------------------------
# Identity / Authentication — RS256 JWT signing (Phase 6, ADR-035)
# --------------------------------------------------------------------------
# A throwaway keypair, generated for this template — not derived from
# anything sensitive, never reused for UAT or PROD. `environment=dev` is not
# `is_local`, so Settings won't auto-generate an ephemeral one the way the
# bare "local" default does; this DEV environment needs its own real value,
# same as LPG_DB_PASSWORD above. `\n` is a literal two-character escape,
# unescaped by Settings' own validator — the PEM's actual newlines don't
# survive a single-line env var.
LPG_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDOl4vsyRMk9opR\nSyjMmoIHy7dH3Jwzs4UBPjq3z0DkVuK5rGtKoM9TE694K8tHqqeXfO7cdIhS1vJw\nVGPFDpohRvthc8dX0UJNVZo68TMimD0P6EJrh9rL4gUWF2fJ80YhHmpYl0Aqe8kO\nA9aOKRxdG8ouaLkAJbXPKROi8AX3U9XDUr0955NoNueTy2IgON+tpMsX1C8gO486\niYWtgV77dlaVNSekThTWHV9pBFygA04BTElf8gQVoQWlGnt1F6QnvRTtiyNuFzve\nDunRn9NhKgPNwdq69uWnWgBBEGjRQRmbXcHBeOfWgFqshj4FQBoKsKVyUqeouCbU\nLtpSnZ3jAgMBAAECggEAGxenq3FBF/dW80tCefaHN+OA0SU+vM79kcip5aIB1hAI\n4qWYWmyVU8VAnSdNHMRl/wlMv89uc0Kp/44pmVWNY/DNlZ2b1knkgoTH2ZP5Cz/g\nvh3M3BIwYM1uslN2cnb7SuuUsbKAITIjjzl0oScGB7XVwVlNbZYEbjrqTtNgTOtO\nkbFgU97goVuPalIIEWsUCgCwcptoaBPRQMQCypTtNT2VfGJUq2LRHPH/xZU5cqAu\n6wHY1mCNlNRpf+LYbga7kz3bnRrcwQhhzTHcptunGN3nsSNjBZe97XFkM9agiKSe\niaOvJWxNSw5D52BEiK83znul+QZFBKU7Bj/sSAfWwQKBgQD6tbjvUNnmPp4/1bxa\nw1hSHTWTUMHvqxrCI7MXcaz3cyfkWPqBoPDpNcES+tBqx/ue/tibE/d2g7dnxMnx\n0mqRhd/vw1lVS1hUD4H42ALuD2PQ5r5mmnWsFsSCX0s3DXr5QsxC4Yt5TUf8/fn0\nkr1Jvf1gPy4y/qoKfNI5QTkqowKBgQDS84Jr4Fu3jQw3/K+3HpbY+y6zqmvFUYbP\nXYr6zux+OYrRE4+khHGxfnXN4VAbXuY7atxLrpNFA3lIM468wL2dvGfV3AF3SAyb\nxkepmZ3o7EqkiVzHTm19nxSZ60b6WpQQlMo+yS/hBk6LDq3FBJsxtdkSGIz9eeXZ\nZY6Bd0IzwQKBgDaFRk5k2r4DaA6hwHBMgux4haofqc0g/JSzhsLWabL2S/qQjwmZ\nokpU8kPaX3CZRNLywNAYq3wOcNgUJ4Z7J8m1v1k4tjiiRfch2DXxY9G5bw+C3m0Z\nsfVWji1747N5LwD90cXJnrcmYz1VTgIt1xQuSOehVb6pOvlE48KnuHLZAoGATtad\nHo4KGQ5Iy7/PN+PhwpQVfyYpAuSWOneeUl/1OLNusvbZj0XEa+50Po5/bstHxlsI\nm+xRs9A5iodiSB7MfuAD+oQvtBGkTK+M5tC3mG5+8wE3QHGKMBG9FE0/CJ/DiHLj\nJxXvo+zEe+nvfZtcGPb6em3ce3sMMPRojvAwOMECgYEAwxRQ9X10E/5Ui2WrD0GW\n1rZiwrEmO3wNsGYa4++LwJZF4VMec+YIoedK8yj281R/Ao5JZKCjA7FoQDP1OvV4\np4AcEaxvPE75COzYF+j1W0TSvzLZc9T9lQcuFcoBtoWyvSpglVAO0Zu8RdIngACy\ngFphPTGRt8ew16QTJF4dBPA=\n-----END PRIVATE KEY-----\n
